# 统一使用 LF，避免 Windows/Linux 行尾差异污染 diff
* text=auto eol=lf

# 二进制文件不做行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.7z   binary

# 锁文件不参与语言统计
pnpm-lock.yaml  linguist-generated=true
package-lock.json linguist-generated=true
yarn.lock       linguist-generated=true
