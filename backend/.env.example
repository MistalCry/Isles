# 群岛（Isles）后端环境变量示例（复制为 .env 或由部署环境注入；禁止提交真实值）
# 说明：application.yml 已为 local profile 提供开发默认值；生产环境必须显式配置。

# 运行 profile：local / prod
SPRING_PROFILES_ACTIVE=local

# 服务端口
SERVER_PORT=8080

# MySQL 连接（生产必须使用专用账号，最小权限，禁止使用 root）
DB_URL=jdbc:mysql://localhost:3306/my_social_channel?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=isles
DB_PASSWORD=change-me

# JWT 密钥：HS256，至少 32 字节；每个环境不同；禁止写入代码仓库
JWT_SECRET=change-me-to-a-random-32-bytes-minimum-secret

# Refresh Token Cookie 是否仅 HTTPS 传输（生产必须 true）
COOKIE_SECURE=false

# 上传根目录（图片 ≤10MB、视频 ≤200MB）
UPLOAD_DIR=./uploads

# CORS 允许的前端源（逗号分隔，禁止生产使用 *）
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Redis（M1 未使用，预留 M2 限流/缓存/PubSub）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
