# 复制为 .env 后按需修改（.env 已在 .gitignore 中，不会入库）

# 走 SOCKS5（v2rayN 默认 10808）—— 需要镜像里的 HTTP 客户端支持 socks
SEARXNG_HTTPS_PROXY=socks5h://host.docker.internal:10808

# 如果 SOCKS 不通，改成 v2rayN 的 HTTP 代理端口（需在 v2rayN 里开启 HTTP 代理，通常是 10809）
# SEARXNG_HTTPS_PROXY=http://host.docker.internal:10809

# 不需要代理时留空
# SEARXNG_HTTPS_PROXY=
