# 复制为 deploy/.env 后填写（deploy/.env 已被 git 忽略，禁止提交真实密钥）
# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=isles
MYSQL_USER=isles_app
MYSQL_PASSWORD=change-me-db
# 应用
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=change-me-please-use-at-least-32-bytes-random
REDIS_PASSWORD=change-me-redis
# 浏览器实际访问的源，多个用逗号分隔；生产必须是精确域名（不要用 * 通配）
# 若同时用 http:// 与 https:// 或带/不带 www，都要分别列出
CORS_ALLOWED_ORIGINS=https://your-domain.example.com
HTTP_PORT=80
# 限流（docs/07 §7）：多实例/容器部署用 redis 共享配额；Nginx 之后按 X-Forwarded-For 计数
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=redis
RATE_LIMIT_TRUST_FORWARDED_FOR=true
# AI：API Key 落库加密密钥（≥32 字节随机值，生产必填）；频道助手自动任务调度
AI_API_KEY_SECRET=change-me-please-use-at-least-32-bytes-random
AI_SCHEDULER_ENABLED=true
# 平台管理员用户名白名单（逗号分隔；也可直接改 users.platform_role=ADMIN）
PLATFORM_ADMIN_USERNAMES=

# 说明：
# - 生产环境建议把 JWT_SECRET / 数据库密码 / Redis 密码替换为随机值，并只保存在服务器 .env 中。
# - 若启用 HTTPS，请在 nginx 前加一层 TLS 终端（如 Caddy / 云负载均衡）或扩展 deploy/nginx.conf 配置证书。
